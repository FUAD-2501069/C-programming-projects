//Right-Leaning Parallelogram
# include<stdio.h>
int main(){
int i,j,r;
scanf("%d",&r);
for(i=r;i>=1;i--){
    for(j=i;j<r;j++){
        printf(" ");
    } for(j=1;j<=r;j++){
    printf("*");
    }
    printf("\n");
}
return 0;
}





