//Alphabet Pyramid(Same Letter per Row)
# include<stdio.h>
int main(){
int i,j,r;
scanf("%d",&r);
for(i=1;i<=r;i++){
    for(j=i;j<r;j++){
        printf(" ");
    } for(j=1;j<=2*i-1;j++){
    printf("%c",'A'+i-1);
    }
    printf("\n");
}
return 0;
}

//Continuous Alphabet Pyramid
# include<stdio.h>
int main(){
int i,j,r;
char n='A';
scanf("%d",&r);
for(i=1;i<=r;i++){
    for(j=i;j<r;j++){
        printf(" ");
    } for(j=1;j<=2*i-1;j++){
    printf("%c",n);
    n++;
    }
    printf("\n");
}
return 0;
}

