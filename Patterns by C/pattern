//Right Half Pyramid
#include<stdio.h>
int main(){
int i,j,r;
scanf("%d",&r);
for(i=1;i<=r;i++){
    for(j=1;j<=i;j++){
        printf("*");
    }printf("\n");
}
return 0;
}

//Right-Aligned Number Triangle
# include<stdio.h>
int main(){
int i,j,r;
scanf("%d",&r);
for(i=1;i<=r;i++){
    for(j=i;j<r;j++){
        printf(" ");
    } for(j=1;j<=i;j++){
    printf("%d",i);
    }
    printf("\n");
}
return 0;
}

//Full/Centered Pyramid
# include<stdio.h>
int main(){
int i,j,r;
scanf("%d",&r);
for(i=1;i<=r;i++){
    for(j=i;j<r;j++){
        printf(" ");
    } for(j=1;j<=2*i-1;j++){
    printf("*");
    }
    printf("\n");
}
return 0;
}

//Continuous Number Pyramid
# include<stdio.h>
int main(){
int i,j,r,num=1;
scanf("%d",&r);
for(i=1;i<=r;i++){
    for(j=i;j<r;j++){
        printf(" ");
    } for(j=1;j<=i;j++){
    printf(" %d",num);
    num++;
    }
    printf("\n");
}
return 0;
}

//Inverted Right-Aligned Triangle
# include<stdio.h>
int main(){
int i,j,r;
scanf("%d",&r);
for(i=r;i>=1;i--){
    for(j=i;j<r;j++){
        printf(" ");
    } for(j=1;j<=i;j++){
    printf("  *");
    }
    printf("\n");
}
return 0;
}

